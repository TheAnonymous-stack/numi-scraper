    "question_number": "4_3",
    "tag": "Gr6_32_E4",
    "correct_answers": [
      "36"
    ],
    "solution": [
      [
        "1/3",
        "To find 80% of 45, convert the percentage to a decimal:\n$80\\% = 0.8$"
      ],
