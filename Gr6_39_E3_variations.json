        "question_text": "Solve for $m$ where $m + 17 = 93$. $m = ?$",
        "correct_answers":[
            "76"
        ],
        "solution": [
            [
                "1/3",
                "Subtracting 17 from both sides to isolate for $m$."
            ],
            [
                "2/3",
                "$m + 17 - 17$ = 93 - 17"
            ],
            [
                "3/3",
                "m = 76."
            ]
