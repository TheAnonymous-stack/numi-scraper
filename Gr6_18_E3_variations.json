      "1"
    ],
    "solution": [
      [
        "1/4",
        "You can use 12 as the common denominator. Multiply the numerator and the denominator of $\\frac{3}{6}$ by 2 to find an equivalent fraction."
      ],
      [
        "2/4",
        "$\\frac{3 \\times 2}{6 \\times 2} = \\frac{6}{12}$"
      ],
      [
        "3/4",
        "Now subtract the fractions. Subtract the numerators and keep the denominators the same."
      ],
      [
        "4/4",
        "$\\frac{11}{12}-\\frac{6}{12} = \\frac{5}{12}$"
      ]
    ],
    "has_alternate_answers": false
