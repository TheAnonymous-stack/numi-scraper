[
  {
    "skills": "probability-of-opposite-mutually-exclusive-and-overlapping-events",
    "question_text": "You draw from two cards.\nWhat is P(not king)?== _",
    "tag": "Gr6_45_E2",
    "question_number": "2_1_1",
    "question_type": "Multiple Choice Question with Single Answer",
    "choices": [
      "60%",
      "40%",
      "70%",
      "50%"
    ],
    "correct_answers": [
      "D"
    ],
    "solution": [
      [
        "1/5",
        "Remember, P(not A) = 1 - P(A)"
      ],
      [
        "2/5",
        "Find P(king). Draw from two cards has two possibilities: ace or king.\nP(king)=$\\frac{1}{2}$"
      ],
      [
        "3/5",
        "Now find P(not king)."
      ],
      [
        "4/5",
        "P(not king)\n=1-P(king)\n=$1-\\frac{1}{2}$\n=$\\frac{1}{2}$"
      ],
      [
        "5/5",
        "Write your answer as a decimal. Then convert your answer to a percentage.\n$\\frac{1}{2} = 0.5 = 50\\%$\nP(not king) = 50%"
      ]
    ]
  },
